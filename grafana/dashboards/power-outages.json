      "targets": [
        {
          "dataset": "outages",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH time_window AS (\r\n  -- Use to_timestamp with Grafana's epoch variables. This is the most reliable method.\r\n  SELECT to_timestamp($__unixEpochFrom()) AS start_date, to_timestamp($__unixEpochTo()) AS end_date\r\n),\r\nrelevant_outages AS (\r\n  SELECT provider, start_time, end_time, affected_customers\r\n  FROM power_outages\r\n  WHERE start_time <= (SELECT end_date FROM time_window) AND\r\n        (end_time >= (SELECT start_date FROM time_window) OR end_time IS NULL)\r\n),\r\ntime_series AS (\r\n  SELECT generate_series(\r\n    date_bin('$bucket_interval', (SELECT start_date FROM time_window), '2000-01-01 00:00:00'),\r\n    (SELECT end_date FROM time_window),\r\n    '$bucket_interval'\r\n  ) AS time_bucket\r\n),\r\nall_providers AS (\r\n  SELECT DISTINCT provider FROM relevant_outages\r\n),\r\nscaffold AS (\r\n  SELECT time_bucket, provider FROM time_series CROSS JOIN all_providers\r\n)\r\nSELECT\r\n  s.time_bucket AS \"time\",\r\n  s.provider AS metric,\r\n  COALESCE(SUM(ro.affected_customers), 0) AS value\r\nFROM\r\n  scaffold s\r\nLEFT JOIN\r\n  relevant_outages ro ON\r\n    ro.provider = s.provider AND\r\n    ro.start_time <= s.time_bucket AND\r\n    (ro.end_time > s.time_bucket OR ro.end_time IS NULL)\r\nGROUP BY\r\n  s.time_bucket, s.provider\r\nORDER BY\r\n  \"time\", metric;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
