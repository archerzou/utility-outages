        {
          "dataset": "outages",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH time_window AS (\r\n  -- TODO: Use $__timeFrom and $__timeTo to be dynamic.\r\n  SELECT (NOW() - INTERVAL '1 month') AS start_date, NOW() AS end_date\r\n),\r\ntime_series AS (\r\n  SELECT generate_series(\r\n    date_bin('$bucket_interval', (SELECT start_date FROM time_window), '2000-01-01 00:00:00'),\r\n    (SELECT end_date FROM time_window),\r\n    '$bucket_interval'\r\n  ) AS time_bucket\r\n),\r\nall_providers AS (\r\n  -- Get unique list of relevant providers.\r\n  SELECT DISTINCT provider FROM power_outages WHERE start_time >= (SELECT start_date FROM time_window)\r\n),\r\nscaffold AS (\r\n  -- Create template of every provider for every time bucket.\r\n  SELECT time_bucket, provider FROM time_series CROSS JOIN all_providers\r\n)\r\n-- Join the complete template against the outages table based on overlapping time.\r\nSELECT\r\n  s.time_bucket AS \"time\",\r\n  s.provider AS metric,\r\n  -- Count the distinct outages that were active during this specific time bucket.\r\n  COUNT(DISTINCT po.id) AS value\r\nFROM\r\n  scaffold s\r\nLEFT JOIN\r\n  power_outages po ON\r\n    -- The provider must match.\r\n    po.provider = s.provider AND\r\n    -- AND the outage must have started ON OR BEFORE this time bucket began.\r\n    po.start_time <= s.time_bucket AND\r\n    (po.end_time > s.time_bucket OR po.end_time IS NULL)\r\nGROUP BY\r\n  s.time_bucket, s.provider\r\nORDER BY\r\n  \"time\", metric;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
