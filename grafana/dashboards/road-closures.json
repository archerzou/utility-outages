        {
          "dataset": "outages",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH time_window AS (\r\n  -- Use to_timestamp with Grafana's epoch variables for reliability.\r\n  SELECT to_timestamp($__unixEpochFrom()) AS start_date, to_timestamp($__unixEpochTo()) AS end_date\r\n),\r\ntime_series AS (\r\n  -- Generate a continuous series of time intervals for the whole period.\r\n  SELECT generate_series(\r\n    date_bin('$bucket_interval', (SELECT start_date FROM time_window), '2000-01-01 00:00:00'),\r\n    (SELECT end_date FROM time_window),\r\n    '$bucket_interval'\r\n  ) AS time_bucket\r\n),\r\nall_regions AS (\r\n  -- Un-nest the JSONB region array to get a distinct list of all region strings.\r\n  SELECT DISTINCT value AS region\r\n  FROM road_events, jsonb_array_elements_text(region)\r\n  WHERE start_time >= (SELECT start_date FROM time_window) AND region IS NOT NULL\r\n),\r\nscaffold AS (\r\n  -- Create a template of every region for every time bucket.\r\n  SELECT time_bucket, region FROM time_series CROSS JOIN all_regions\r\n)\r\n-- Join the complete template against the road_events table based on overlapping time and region.\r\nSELECT\r\n  s.time_bucket AS \"time\",\r\n  s.region AS metric,\r\n  -- Count the distinct road events that were active in this region during this time bucket.\r\n  COUNT(DISTINCT re.id) AS value\r\nFROM\r\n  scaffold s\r\nLEFT JOIN\r\n  road_events re ON\r\n    -- CRITICAL: Check if the region text from our scaffold exists as an element\r\n    -- in the event's JSONB region array. The '?' operator is perfect for this.\r\n    re.region ? s.region AND\r\n\r\n    -- AND the event must have started ON OR BEFORE this time bucket began.\r\n    re.start_time <= s.time_bucket AND\r\n\r\n    -- AND the event must have ended AFTER this time bucket began, OR it has not ended yet.\r\n    (re.end_time > s.time_bucket OR re.end_time IS NULL)\r\nGROUP BY\r\n  s.time_bucket, s.region\r\nORDER BY\r\n  \"time\", metric;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Road Closures by Region",
      "transformations": [
