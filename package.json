{
    "name": "utility-outage-monorepo",
    "version": "0.1.0",
    "private": true,
    "packageManager": "bun@1.2.5",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "start": "turbo run start",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{js,ts,tsx,md}\""
    },
    "devDependencies": {
        "turbo": "latest"
    }
}